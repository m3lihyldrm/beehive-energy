# ==========================================
# BeeHive Environment Variables Example
# ==========================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SITE_URL=https://beehive.energy
# Privacy-friendly analytics (Plausible) - Leave blank in local development
VITE_PLAUSIBLE_DOMAIN=beehive.energy

# Backend (Node.js / Express)
PORT=5000
CORS_ORIGIN=*
DEMO_ADMIN_EMAIL=admin@beehive.energy
DEMO_ADMIN_TOKEN=beehive-admin-jwt-token-2026
DEMO_ADMIN_PASSWORD=Demo123!

# Resend API for Demo Requests / Contact Form
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL_TO=demo@beehive.energy
CONTACT_EMAIL_FROM=BeeHive Platform <noreply@beehive.energy>
